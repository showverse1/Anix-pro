rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check authentication
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is admin
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.uid in ["admin_anix_primary", "creator_super_anix", "ANIX_ADMIN_ROOT"]
      );
    }
    
    // /media/{mediaId}
    // Public read for anime/series catalog, write only for authenticated Admin UIDs
    match /media/{mediaId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // /subscriptions/{txnId}
    // Users can create a subscription entry with their own UID & 12-digit UTR
    // Read allowed for owner or Admin
    match /subscriptions/{txnId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if isAuthenticated() 
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.transactionId.matches('^[0-9]{12}$');
      allow update, delete: if isAdmin();
    }
    
    // /users/{uid}/subscription/current
    // User can read their own active subscription status; admin or cloud functions can write
    match /users/{uid}/subscription/current {
      allow read: if isAuthenticated() && (request.auth.uid == uid || isAdmin());
      allow write: if isAuthenticated() && (request.auth.uid == uid || isAdmin());
    }
    
    // Catch-all
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
